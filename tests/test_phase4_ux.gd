extends "res://tests/preview_world_phase1.gd"
const Journal = preload("res://scripts/experiment_journal.gd")
const Sim = preload("res://scripts/mana_simulator.gd")
const Research = preload("res://scripts/character_research.gd")
const Helper = preload("res://tests/test_chant.gd")
func run() -> void:
	root.gui_embed_subwindows = true
	var path := "res://.task002_artifacts/phase4_m1/ux_"+str(Time.get_ticks_usec())+".json"
	A.write(path, F.fixture("WATER", 1787453028)); game = Scene.instantiate(); game.save_path = path; root.add_child(game); game.set_process(false)
	var original_mapping: Dictionary = game.chant_profile.to_data()
	var original_research: Dictionary = game.research.to_data()
	game.player_pos = game.layout.LAB_DOOR; game._enter_laboratory()
	check(game.game_state == "LAB" and game.laboratory_panel.exit_button.text == "나가기" and not game.laboratory_panel.release_button.visible, "Research lab has Exit and no mandatory release button")
	A.enter_keys(game, [Helper.first_for(game.chant_profile, "WATER")]); game._observe_first_word()
	check(game.journal.to_data()["observed_first_words"].values().has("WATER") and game.runes.is_empty() and game.research.to_data() == original_research, "Observed first word is saved separately without slots, affinity, or accidental release")
	game.laboratory_panel.show_trial()
	check(game._controlled_trial() == game.laboratory_panel.arena and not game.laboratory_panel.trial_release_button.visible, "Separate controllable experiment arena remains distinct from research/replay view")
	var arena = game.laboratory_panel.arena
	arena.player_pos = Vector2(630, 130); game._interact()
	check(game.research.has_clue("WOOD", "environment") and game.research.main_attribute == "WATER", "Actual catalyst is reachable and E records an environmental clue without awakening")
	game._reset_combat_input(); A.enter_keys(game, ["X", "T", "C"])
	var event := InputEventKey.new(); event.keycode = KEY_SPACE; event.physical_keycode = KEY_SPACE; event.pressed = true
	game._input(event); event.pressed = false; game._input(event)
	var count: int = game.journal.records().size()
	event.keycode = KEY_SHIFT; event.physical_keycode = KEY_SHIFT; game._input(event)
	check(game.runes.is_empty() and game.journal.records().size() == count and arena.missiles.is_empty(), "Space cancellation consumes the mobile session; later Shift-up cannot release")
	game._reset_combat_input(); game.combat_input._set_mode(game.CombatInput.Mode.FOCUS_CAST)
	arena.navigation.request(arena, Vector2(950,200)); var position: Vector2 = arena.player_pos
	game.player_mana = 20; game._process(0.5); arena.advance(0.5)
	check(arena.player_pos == position and game.player_mana == 28.0 and not arena.navigation.active, "Focus remains immobile in the experiment arena and regenerates 16 mana/s")
	event.keycode = KEY_SPACE; event.physical_keycode = KEY_SPACE; event.pressed = true; game._input(event)
	game.player_mana = 20; game._process(0.5)
	check(game.combat_input.mode == game.CombatInput.Mode.NORMAL and game.player_mana == 24, "Space exits focus and restores ordinary 8 mana/s immediately")
	game.laboratory_panel.show_journal()
	var empty := Sim.simulate(game.chant_profile, [{"key":"X", "at_ms":0, "hold_ms":0}])
	for i in 500: game.journal.append(empty, "failed", 0, 0, 1)
	var protected_id: int = game.journal.append(empty, "failed", 0, 0, 1); game.journal.protect(protected_id, true)
	var success := Sim.simulate(game.chant_profile, D.inputs(game.chant_profile, "WATER", ["ACCUMULATE","DIRECT"]))
	var favorite_id: int = game.journal.append(success, "released", 9, 200, 1)
	game.journal.mark_manifestation(favorite_id, {"spell_id":"WATER_PUSH", "name":"Tidebolt"})
	game.discovered.record("WATER_PUSH", "Tidebolt", D.inputs(game.chant_profile, "WATER", ["ACCUMULATE","DIRECT"]), 6, "LAB")
	game.discovered.set_favorite("WATER_PUSH", true); game._save_character()
	var before_size := FileAccess.get_file_as_bytes(path).size()
	var discovery: Dictionary = game.discovered.to_data(); var research: Dictionary = game.research.to_data()
	var no_result: Array = []
	for record in game.journal.records():
		if Journal.category(record) == "no_result": no_result.append(record["id"])
	check(no_result.size() >= 500 and favorite_id not in game._journal_evidence_ids(), "Spell favorites do not lock user observation deletion")
	game.journal_manager.request_delete(no_result)
	check(game.journal_manager.confirm.dialog_text.contains(str(game.journal.eligible_ids(no_result,[]).size())), "Bulk deletion confirmation reports the exact eligible count excluding user preservation")
	game.journal_manager.confirm.hide()
	var expected_deleted:int=game.journal.eligible_ids(no_result+[protected_id,favorite_id],[]).size()
	var deleted: int = game._delete_journal_records(no_result + [protected_id, favorite_id])
	check(deleted==expected_deleted and not Journal.has_id(game.journal.records().map(func(r):return r.id),favorite_id) and Journal.has_id(game.journal.records().map(func(r):return r.id),protected_id), "User preservation remains while a spell favorite does not lock its observation")
	check(FileAccess.get_file_as_bytes(path).size() < before_size and FileAccess.file_exists(path+".journal_delete.bak"), "Deletion reduces the actual save file and creates a recovery backup")
	check(game.discovered.to_data() == discovery and game.chant_profile.to_data() == original_mapping and game.research.to_data() == research, "Deletion preserves discovered spells, mapping, research and favorite integrity")
	check(game._restore_journal_delete() and game.journal.records().size() == count + 502, "Deletion can be restored without losing newer IDs")
	var previous: Dictionary = game.journal.to_data()
	DirAccess.make_dir_absolute(path + ".tmp")
	check(game._delete_journal_records(no_result) == 0 and game.journal.to_data() == previous, "Save failure rolls back the whole deletion transaction")
	DirAccess.remove_absolute(path + ".tmp")
	game._set_journal_auto_failures(false); A.enter_keys(game, ["X"]); game._cancel_spell()
	check(game.journal.records().size() == previous["records"].size(), "Failure/cancel auto-recording can be disabled without disabling successful discoveries")
	game._leave_laboratory()
	check(game.player_pos == game.layout.LAB_DOOR and game.game_state == "DUNGEON", "Exit returns to the actual town laboratory threshold")
	var mentors := 0
	for entry in game.layout.interactions:
		if not str(entry["id"]).begins_with("mentor_"): continue
		mentors += 1; game.player_pos = entry["pos"]; game._interact()
		check(game.mentor_dialog.visible and game.research.has_clue(str(entry["id"]).trim_prefix("mentor_"), "mentor") and not game._is_blocked(game.player_pos), "A physically reachable elemental mentor records a clue: "+entry["id"])
		game.mentor_dialog.hide()
	check(mentors == 5 and game.layout.nearest(Vector2(430,1190))["id"] == "rest", "Five mentors coexist with the unchanged communal recovery/checkpoint")
	var model := Research.new(); model.acquire_clue("WOOD", "book", "book_WOOD")
	var proof_inputs := Helper.inputs(A.sequence(game.chant_profile, "WOOD"))
	model.record_resonance(game.chant_profile, proof_inputs, 1)
	check(model.stable_count("WOOD") == 1 and model.begin_ritual("WOOD") == "ritual_started" and model.main_attribute == null, "One basic clue and one stable experiment allow a manual ritual without auto-awakening")
	print("PHASE4 UX: %d checks, %d failures" % [checks, failures]); game.free(); quit(1 if failures else 0)
