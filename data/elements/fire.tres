[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/element_definition.gd" id="1"]

[resource]
script = ExtResource("1")
element_id = &"FIRE"
display_name = "火 · 화"
domain = "열 · 연소"
resonance_required = 50.0
resonance_stability = 60.0
weak_observation = "온기가 희미하게 스칩니다."
partial_observation = "온기가 흔들리며 흩어집니다."
stable_observation = "잔잔한 온기와 일정한 빛이 유지됩니다."
book_clue = "火는 온기와 열의 흔적으로 드러난다. 먼저 잔광을 축적하고 좁게 모은 뒤 떨림이 가라앉은 상태에서 공명을 탐색하라. 개화 후 더 많은 마나와 강한 응집은 뻗어나가는 창을, 덜 응집된 풍부한 마나와 겹친 윤곽은 넓은 폭발을 만들 수 있다."
mentor_clue = "불규칙한 온기는 아직 완성이 아니다. 안정화와 공명을 번갈아 시험하고, 의식에서는 형상과 방향까지 유지하라. 화염의 심화 형태는 공명을 보존한 채 시험하라. 창은 강하게 모으고, 폭발은 넓은 형상을 충분히 유지하되 과도하게 압축하지 마라."
derived_concepts = PackedStringArray()
